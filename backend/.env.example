# Copy this file to backend/.env and fill in YOUR OWN values.
# backend/.env is gitignored — never commit real secrets.

# Your own MongoDB connection string (Atlas free tier is fine):
MONGO_URI=mongodb+srv://<your-db-user>:<your-db-password>@<your-cluster>.mongodb.net/riceShop?retryWrites=true&w=majority

PORT=5000

# Comma-separated list of origins allowed to call this API.
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK credentials — from YOUR OWN Firebase project:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Comma-separated list of emails allowed to access admin-only API routes.
ADMIN_EMAILS=you@example.com

# Razorpay — Dashboard -> Settings -> API Keys (use TEST mode keys while developing).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret
